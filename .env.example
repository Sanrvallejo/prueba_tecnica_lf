# API
PORT=4000

# LLM: Ollama (siempre registrado, modelo por defecto; en docker-compose OLLAMA_URL se define en el servicio api)
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# LLM: OpenAI (se registra solo si hay OPENAI_API_KEY y OPENAI_MODEL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
