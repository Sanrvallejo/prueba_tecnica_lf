# API
PORT=4000

# LLM: Ollama (siempre registrado, modelo por defecto; en docker-compose OLLAMA_URL se define en el servicio api)
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# LLM: OpenAI (se registra solo si hay OPENAI_API_KEY y OPENAI_MODEL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: se eligen al arrancar (ollama | openai). Cambiarlos exige reindexar.
# El modelo debe estar en embedding-models.catalog.ts
EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (en docker-compose QDRANT_URL se define en el servicio api)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Redis para la cola de ingesta (en docker-compose REDIS_HOST se define en el servicio api)
REDIS_HOST=localhost
REDIS_PORT=6379

# Unstructured (en docker-compose UNSTRUCTURED_URL se define en el servicio api)
UNSTRUCTURED_URL=http://localhost:8000
